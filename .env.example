# Copy to .env for a local development database. Use unique values.
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
# Separate 32-byte hex key for encrypting staff authenticator secrets in production.
# STAFF_MFA_KEY=<64 hexadecimal characters>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Configure SMTP before production use. Without it, development messages go to
# a private local dev-mailbox beside the SQLite database.
APP_BASE_URL=http://localhost:3000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=account-name
# SMTP_PASS=account-password
# MAIL_FROM=Payvexis <no-reply@example.com>
# Alternatively, the Vercel Resend integration supplies RESEND_API_KEY. Set
# MAIL_FROM to an address on a domain verified in Resend; SMTP defaults to
# smtp.resend.com:465 with the key as its password.
# RESEND_API_KEY=replace-with-resend-api-key

# PostgreSQL staging import only. Run npm run migrate:postgres after migrations 001-006.
# The application remains on SQLite until its database runtime is ported and validated.
# DATABASE_URL=postgresql://user:password@localhost:5432/payvexis
# PG_STAGE_SCHEMA=payvexis_stage_20261006

# Optional local demo records. Ignored in production.
DEMO_SEED=false

# Enable only with a disposable/demo database after npm run migrate:ledger.
# No external payment provider is involved. Ignored in production.
DEMO_INTERNAL_TRANSFERS=false

# Enable two-person demo balance corrections only with a disposable/demo database.
# No external funds are created. Ignored in production.
DEMO_ADMIN_ADJUSTMENTS=false
